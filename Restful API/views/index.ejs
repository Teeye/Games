<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Main Page</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora Posts</h1>
  <%  for(let post of posts){%>
         <div class="post">
        <p class="user">@<%= post.username %></p>
        <p class="content"><%=post.content%></p>
        <a href="/posts/<%= post.id %>">See the Post</a> &nbsp;&nbsp;
        <a href="/posts/<%=post.id%>/edit">Edit the Post</a> 
        <br><br>
        <form method="post" action="/posts/<%= post.id %>?_method=DELETE">    <button>Delete</button> </form>
    </div>
   <% }%>
   <br><br>
   <a href="/posts/add">Add a Post</a>
</body>
</html>