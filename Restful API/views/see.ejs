<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>See the Post</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora Posts</h1>
    <div class="post">
        <p>Id: <%=post.id%> </p>
        <p class="user">@<%=post.username%> </p>
        <p class="content"><%=post.content%></p>
    </div>
    <a href="/posts">BACK</a>
</body>
</html>